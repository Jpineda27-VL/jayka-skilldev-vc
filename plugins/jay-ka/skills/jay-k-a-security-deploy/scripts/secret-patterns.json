{
  "_doc": "Patrones de secretos. Los usan scan-git-secrets.mjs (esta skill) y scan-security.mjs (jay-k-a-security-web). Los valores encontrados se muestran SIEMPRE enmascarados.",
  "patrones": [
    { "id": "clave-privada", "re": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY-----" },
    { "id": "aws-access-key", "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "id": "github-token", "re": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b" },
    { "id": "github-pat", "re": "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b" },
    { "id": "stripe-live", "re": "\\b(?:sk|rk)_live_[A-Za-z0-9]{20,}\\b" },
    { "id": "slack-token", "re": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b" },
    { "id": "google-api-key", "re": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "anthropic-key", "re": "\\bsk-ant-[A-Za-z0-9_-]{32,}\\b" },
    { "id": "openai-key", "re": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}\\b" },
    { "id": "laravel-app-key", "re": "APP_KEY=base64:[A-Za-z0-9+/=]{40,}" },
    { "id": "jwt", "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}" },
    { "id": "url-con-credenciales", "re": "\\b[a-z][a-z0-9+.-]*://[^/\\s:@'\"]{2,}:[^/\\s:@'\"]{3,}@[^\\s/'\"]+" },
    { "id": "asignacion-de-secreto", "re": "(?:api[_-]?key|secret|token|passw(?:or)?d|private[_-]?key|client[_-]?secret)[\"']?\\s*[:=]\\s*[\"']([^\"'\\s]{12,})[\"']", "flags": "i" }
  ],
  "_docFalsos": "Si el valor contiene alguna de estas palabras, se descarta como ejemplo o marcador.",
  "falsosPositivos": ["example", "ejemplo", "your", "tu-", "xxx", "changeme", "placeholder", "dummy", "test", "fake", "sample", "${", "process.env", "env(", "getenv", "<", "****", "redacted"]
}
