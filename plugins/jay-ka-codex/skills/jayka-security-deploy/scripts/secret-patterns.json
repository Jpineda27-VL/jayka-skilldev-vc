{
  "_doc": "Secret patterns. Used by scan-git-secrets.mjs (this skill) and scan-security.mjs (jayka-security-web). Values found are ALWAYS shown masked.",
  "patterns": [
    { "id": "private-key", "re": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY-----" },
    { "id": "aws-access-key", "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "id": "github-token", "re": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b" },
    { "id": "github-pat", "re": "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b" },
    { "id": "stripe-live", "re": "\\b(?:sk|rk)_live_[A-Za-z0-9]{20,}\\b" },
    { "id": "slack-token", "re": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b" },
    { "id": "google-api-key", "re": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "anthropic-key", "re": "\\bsk-ant-[A-Za-z0-9_-]{32,}\\b" },
    { "id": "openai-key", "re": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}\\b" },
    { "id": "laravel-app-key", "re": "APP_KEY=base64:[A-Za-z0-9+/=]{40,}" },
    { "id": "jwt", "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}" },
    { "id": "url-with-credentials", "re": "\\b[a-z][a-z0-9+.-]*://[^/\\s:@'\"]{2,}:[^/\\s:@'\"]{3,}@[^\\s/'\"]+" },
    { "id": "secret-assignment", "re": "(?:api[_-]?key|secret|token|passw(?:or)?d|private[_-]?key|client[_-]?secret)[\"']?\\s*[:=]\\s*[\"']([^\"'\\s]{12,})[\"']", "flags": "i" }
  ],
  "_docFalsePositives": "If the value contains any of these words, it is discarded as an example or placeholder.",
  "falsePositives": ["example", "ejemplo", "your", "tu-", "xxx", "changeme", "placeholder", "dummy", "test", "fake", "sample", "${", "process.env", "env(", "getenv", "<", "****", "redacted"]
}
